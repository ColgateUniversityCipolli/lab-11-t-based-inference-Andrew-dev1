library(e1071)
calculate2 <- function(beta.sample, num1, num2){
tibs <- tibble()|>
summarize(variable = sprintf("Beta(%d,%d)", num1, num2),
mean = mean(beta.sample),
variance = var(beta.sample),
skewness = skewness(beta.sample),
excess.kurtosis = kurtosis(beta.sample)
)
return(tibs)
}
